# Copy to .env and fill in. .env is gitignored.
#
# PostgreSQL connection string, used with `--to postgres`.
# The tool auto-upgrades a bare "postgresql://" to the psycopg (v3) driver,
# so both of these work:
#
#   postgresql://user:password@localhost:5432/tg_history
#   postgresql+psycopg://user:password@localhost:5432/tg_history
#
TG_IMPORTER_DSN=postgresql+psycopg://user:password@localhost:5432/tg_history
